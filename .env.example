# Resend API Key for sending emails (welcome emails, etc.)
# Get your API key from https://resend.com/api-keys
# Required — the app refuses to send email when this is unset.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Email volume guardrails (optional — defaults shown)
# RESEND_DAILY_LIMIT is the plan's daily send cap; campaigns stop early so
# RESEND_TRANSACTIONAL_RESERVE sends stay available for password resets,
# welcome emails and school invites. Raise the limit after a plan upgrade.
RESEND_DAILY_LIMIT=100
RESEND_TRANSACTIONAL_RESERVE=40

# Firebase Admin SDK Service Account (JSON string)
# Get this from Firebase Console > Project Settings > Service Accounts > Generate New Private Key
# Paste the entire JSON contents as a single line string
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"driving-test-app-a5c67",...}

# Stripe Configuration
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=your_stripe_secret_key_here

# Stripe Webhook Secret
# Get this from https://dashboard.stripe.com/webhooks after creating a webhook endpoint
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# Stripe Price ID for Premium ($9.99, the US dollar price; other currencies are
# charged with inline price_data from lib/pricing.ts)
# Create a product and price at https://dashboard.stripe.com/products
STRIPE_SINGLE_PRICE_ID=your_stripe_price_id_here

# ElevenLabs, only for scripts/build-basics-audio.ts (the Basics explainer voice).
# Nothing at runtime reads these; the generated mp3 and timing json are committed under public/basics-audio/.
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=6q6UVsvekS0UjrUXFz79
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# MCP Server: JWT signing secret for OAuth-issued bearer access tokens.
# 32+ char random string — generate with `openssl rand -hex 32`. Rotating this invalidates all live tokens.
MCP_TOKEN_SECRET=PLACEHOLDER_GENERATE_WITH_OPENSSL_RAND_HEX_32

# MCP Server: Public URL of the MCP server (used as the OAuth issuer in discovery metadata).
# Production example: https://tigertest.io
MCP_OAUTH_ISSUER_URL=http://localhost:3000

# Public site URL for metadata, canonicals and email links (lib/siteUrl.ts lifts an apex value to www)
NEXT_PUBLIC_SITE_URL=https://www.tigertest.io

# Bearer token Vercel sends to /api/cron/* and /api/indexnow/ping
CRON_SECRET=PLACEHOLDER_GENERATE_WITH_OPENSSL_RAND_HEX_32

# Claude API key for the daily update on the /admin Today tab (the cron skips when unset)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# IndexNow (Bing) key, 8 to 128 hex characters
INDEXNOW_KEY=your_indexnow_key_here

# Email (optional)
# Reply-To on campaign mail and test-request notifications
EMAIL_REPLY_TO=john@johnbrophy.net
# Postal address in marketing email footers (CAN-SPAM). Campaign sends fail closed if absent.
EMAIL_POSTAL_ADDRESS=
# Per-run campaign cap (default: daily campaign budget / cron count)
# CRON_MAX_BATCH=

# Campaign switches: "send" turns each on; anything else (or unset) is paused
# NEW_TESTS_CAMPAIGN=send
# NEW_TESTS_WINNER=v4
# QUIZZES_CAMPAIGN=send
# EXIT_QUESTION_CAMPAIGN=send

# HMAC signing secret for new unsubscribe links. Existing base64 links still work.
# Configure a strong secret through the deployment's secret settings; never commit it.
EMAIL_UNSUBSCRIBE_SECRET=

# Off by default; no schedule is installed. Review email-release-operations first.
# reconcile settles locally recorded acceptance without sends; retry also replays eligible existing attempts.
EMAIL_RECOVERY_MODE=disabled
