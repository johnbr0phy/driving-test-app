# Resend API Key for sending emails (welcome emails, etc.)
# Get your API key from https://resend.com/api-keys
# Required — the app refuses to send email when this is unset.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Email volume guardrails (optional — defaults shown)
# RESEND_DAILY_LIMIT is the plan's daily send cap; campaigns stop early so
# RESEND_TRANSACTIONAL_RESERVE sends stay available for password resets,
# welcome emails and school invites. Raise the limit after a plan upgrade.
RESEND_DAILY_LIMIT=100
RESEND_TRANSACTIONAL_RESERVE=40

# Firebase Admin SDK Service Account (JSON string)
# Get this from Firebase Console > Project Settings > Service Accounts > Generate New Private Key
# Paste the entire JSON contents as a single line string
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"driving-test-app-a5c67",...}

# Stripe Configuration
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=your_stripe_secret_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here

# Stripe Webhook Secret
# Get this from https://dashboard.stripe.com/webhooks after creating a webhook endpoint
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# Stripe Price ID for Premium ($9.99)
# Create a product and price at https://dashboard.stripe.com/products
STRIPE_PRICE_ID=your_stripe_price_id_here

# ElevenLabs, only for scripts/build-basics-audio.ts (the Basics explainer voice).
# Nothing at runtime reads these; the generated mp3 and timing json are committed under public/basics-audio/.
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=MlIxnl4hUPbFzWffsZ76
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# MCP Server: JWT signing secret for OAuth-issued bearer access tokens.
# 32+ char random string — generate with `openssl rand -hex 32`. Rotating this invalidates all live tokens.
MCP_TOKEN_SECRET=PLACEHOLDER_GENERATE_WITH_OPENSSL_RAND_HEX_32

# MCP Server: Public URL of the MCP server (used as the OAuth issuer in discovery metadata).
# Production example: https://tigertest.io
MCP_OAUTH_ISSUER_URL=http://localhost:3000
