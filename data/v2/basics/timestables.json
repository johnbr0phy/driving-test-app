  {
    "id": "ttGroupsOf",
    "name": "Times means lots of",
    "sub": "What the × sign really means",
    "rule": "× means \"lots of\". 3 × 4 can mean 3 lots of 4 or 4 lots of 3. Both make 12.",
    "trick": "Say \"lots of\" out loud. 3 lots of 4 is 4 + 4 + 4 = 12.",
    "examples": [
      {
        "kind": "eg",
        "text": "3 × 4",
        "note": "3 lots of 4: 4 + 4 + 4 = 12."
      },
      {
        "kind": "eg",
        "text": "2 × 5",
        "note": "2 lots of 5: 5 + 5 = 10."
      }
    ],
    "another": {
      "text": "Imagine 3 plates with 4 strawberries on each plate. Count all the strawberries and you get 12. That is 3 × 4.",
      "example": "● ● ● ●\n● ● ● ●\n● ● ● ●\n3 lots of 4 = 12"
    },
    "walkthrough": {
      "board": "3 × 4",
      "kind": "math",
      "steps": [
        {
          "say": "The × sign means \"lots of\". So 3 × 4 means 3 lots of 4."
        },
        {
          "ask": "How do we write 3 lots of 4 as an adding sum?",
          "options": [
            "4 + 4 + 4",
            "3 + 4"
          ],
          "answer": 0,
          "hint": "3 + 4 only has one 4 in it. We need three 4s.",
          "line": "4 + 4 + 4"
        },
        {
          "ask": "4 + 4 is 8. What is 8 + 4?",
          "options": [
            "12",
            "11"
          ],
          "answer": 0,
          "hint": "Count on 4 from 8: 9, 10, 11, 12.",
          "line": "8 + 4 = 12"
        },
        {
          "ask": "So 3 × 4 is:",
          "options": [
            "12",
            "7"
          ],
          "answer": 0,
          "then": "Yes! 3 lots of 4 is 12.",
          "hint": "7 is 3 + 4. Times means lots of.",
          "line": "3 × 4 = 12 ✓"
        }
      ]
    },
    "questions": [
      {
        "stem": "What does 2 × 6 mean?",
        "options": [
          "2 lots of 6",
          "2 add 6",
          "6 take away 2"
        ],
        "answer": 0,
        "why": "× means lots of. 2 × 6 is 6 + 6 = 12."
      },
      {
        "stem": "Which adding sum is the same as 4 × 2?",
        "options": [
          "2 + 2 + 2 + 2",
          "4 + 2",
          "4 + 4 + 4"
        ],
        "answer": 0,
        "why": "4 lots of 2 is four 2s: 2 + 2 + 2 + 2 = 8."
      }
    ]
  },
