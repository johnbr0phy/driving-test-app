        {
          "ask": "So what is 10 × 3?",
          "options": [
            "30",
            "13"
          ],
          "answer": 0,
          "then": "Same numbers, same answer.",
          "hint": "13 is 10 + 3. We just worked out 3 × 10 = 30.",
          "line": "10 × 3 = 30 ✓"
